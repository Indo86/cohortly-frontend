# Copy to .env (or .env.local) and adjust. Never put secrets in VITE_ variables:
# everything prefixed VITE_ is bundled into the public JavaScript.

# Base URL of the LMS backend API (no trailing slash needed), e.g. the backend's
# "http://localhost:3000". The backend only accepts browser requests from its own
# FRONTEND_URL, so run this app on that origin (default http://localhost:5173).
VITE_API_URL=http://localhost:3000
